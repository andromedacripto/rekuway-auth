# Copy this file to .env and fill in real values.
# NEVER commit the real .env file. gitleaks + .gitignore enforce this.

NODE_ENV=development

# PostgreSQL (Neon in production, docker-compose locally)
DATABASE_URL=postgresql://rekuway:rekuway@localhost:5432/rekuway_auth

# Redis (Upstash in production, docker-compose locally)
REDIS_URL=redis://localhost:6379

# WebAuthn Relying Party config
RP_ID=localhost
RP_NAME=Rekuway Auth
ORIGIN=http://localhost:3000

# Session cookie signing secret — generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-real-random-secret-of-at-least-32-bytes

# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000

# Local dev docker-compose passwords (not used in production)
POSTGRES_PASSWORD=rekuway
REDIS_PASSWORD=rekuway
