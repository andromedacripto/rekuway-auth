// Rekuway Auth — Prisma schema
// PostgreSQL is the permanent store. Redis (see apps/api/src/plugins/redis.ts)
// holds only temporary data: challenges, intermediate nonces, rate limits.
//
// MULTI-TENANCY (pooled model, one shared database — same pattern used by
// WorkOS, Clerk, and Auth0 for the vast majority of tenants): every User
// belongs to exactly one Organization. Every child record (credentials,
// devices, sessions, security events) is scoped transitively through
// userId, so authenticated routes remain tenant-safe automatically as long
// as registration/login always resolve users within the correct
// Organization. Row-Level Security is layered on top in Postgres as
// defense-in-depth — see prisma/migrations/<timestamp>_add_rls/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  // URL-safe identifier used to resolve tenant context at registration/login
  // (e.g. shared domain `auth.rekuway.com` + this slug). Immutable in
  // practice — changing it would break every WebAuthn RP association a
  // client already holds pointed at the old value if it were ever embedded
  // client-side, so treat it as a stable identifier once created.
  slug      String   @unique
  createdAt DateTime @default(now())

  users User[]

  @@index([slug])
}

model User {
  id             String    @id @default(uuid())
  organizationId String
  email          String
  emailVerified  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  credentials    WebAuthnCredential[]
  touchSequence  TouchSequence?
  devices        Device[]
  sessions       Session[]
  securityEvents SecurityEvent[]

  // Email is unique WITHIN an organization, not globally — the same person
  // (same email) can legitimately be a user of two different client
  // companies without collision.
  @@unique([organizationId, email])
  @@index([organizationId])
}

model WebAuthnCredential {
  id           String    @id @default(uuid())
  userId       String
  // credentialId is inherent to WebAuthn/FIDO2 itself — authenticators
  // generate it independent of any tenant, so it stays globally unique
  // rather than scoped per-organization.
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  deviceType   String // "singleDevice" | "multiDevice"
  backedUp     Boolean   @default(false)
  transports   String[] // e.g. ["internal", "hybrid"]
  aaguid       String?
  deviceId     String?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// The 3-Touch sequence — stored ONLY as a bcrypt hash, never in plaintext.
// Explicitly not treated as a cryptographic secret; see auth-core RiskEngine
// and apps/api/src/lib/touchSequence.ts for how it is bound to a
// WebAuthn-verified intermediate nonce before being accepted.
model TouchSequence {
  id           String   @id @default(uuid())
  userId       String   @unique
  sequenceHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id          String   @id @default(uuid())
  userId      String
  deviceName  String
  platform    String // "web" | "android" | "ios" | "unknown"
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  revokedAt   DateTime?

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentials WebAuthnCredential[]
  sessions    Session[]

  @@index([userId])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  deviceId  String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventType String
  // Non-secret contextual metadata only. Never passwords, tokens, keys,
  // cookies, challenges, or biometric data (spec sections 31-32).
  metadata  Json     @default("{}")
  ipHash    String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
}
